---
import Base from "../../layouts/Base.astro";
import { draftJudges, byVicinage, includeDrafts, rosterManifest } from "../../lib/content.js";

const groups = includeDrafts ? byVicinage(draftJudges) : [];
---

<Base title="Drafts" draft={true}>
  <div class="breadcrumb" slot="breadcrumb"><a href="/">Home</a> &nbsp;›&nbsp; Drafts</div>

  <div class="pagehead">
    <h1>Drafts</h1>
    <div class="role">Records rendered for review. None of this is published.</div>
  </div>

  <section class="block">
    <div class="draftnote" style="margin-top:0">
      <b>Read the page, not the JSON.</b>
      These pages exist so a record can be read whole before it is signed, which is what
      <code>data/signoffs.json</code> asks for: ask the question the gate cannot, whether a reader
      would infer a tendency from the selection. Signing is a separate act at the command line, in
      its own commit.
    </div>
    <p style="font-size:12.5px;color:var(--faint);margin:16px 0 0">
      Roster read {rosterManifest.roster_read} from{" "}
      <a href={rosterManifest.roster_source} rel="noopener">the court's Our Judges directory</a>.
      {rosterManifest.counts?.records_total} records total.
    </p>
  </section>

  {!includeDrafts ? (
    <section class="block">
      <div class="empty">
        <strong>Drafts are excluded from this build</strong>
        INCLUDE_DRAFTS is set to 0.
      </div>
    </section>
  ) : (
    groups.map(([vicinage, list]) => (
      <section class="block">
        <h2>{vicinage} Vicinage</h2>
        <ul class="roster">
          {list.map((j) => (
            <li>
              <span class="name"><a href={`/drafts/judges/${j.jurist_id}/`}>{j.canonical_name}</a></span>
              <span class="office">{j.office}</span>
            </li>
          ))}
        </ul>
      </section>
    ))
  )}
</Base>
