{
  // Cloudflare Workers static assets.
  //
  // The assets root is ./dist, the Astro build output. public/ is Astro's
  // static passthrough directory, so _headers, _redirects and both robots files
  // are copied into dist/ during the build and are read from there — Workers
  // reads them from the root of the assets directory, which is why the site
  // will not serve its noindex header if this points anywhere else.
  //
  // The build must run before this deploys. Set the Workers Builds project's
  // build command to `npm run build`, which runs the review gate first and
  // blocks on exit 1, then builds. A deploy with no build step will fail with
  // "Could not detect a directory containing static files" because dist/ is
  // gitignored and will not exist.
  //
  // data/ sits outside the assets root, so the forty-three judge records are
  // versioned on GitHub and never served from the edge. Only what Astro renders
  // into dist/ is published.

  "name": "federal-bench-reference",
  "compatibility_date": "2026-09-08",

  "assets": {
    "directory": "./dist"
  }
}
