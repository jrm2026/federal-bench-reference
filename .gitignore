# Secrets. COURTLISTENER_TOKEN belongs in Actions secrets, never in the tree.
.env
.env.*
!.env.example

# Generated by scripts/check-links.mjs. Regenerable, and it churns on every run.
link-report.json

# Node
node_modules/
npm-debug.log*
.npm/

# Astro build output
dist/
.astro/
.output/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editors and operating systems
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Wrangler local state
.wrangler/

# Written by scripts/reconcile-dockets.mjs. Regenerable.
docket-reconciliation.json

# Compiled from public/_headers by scripts/gen-edge-headers.mjs on every build.
worker/edge-headers.generated.js

# Local Worker secrets for `wrangler dev`. Never committed; the template is.
.dev.vars
.dev.vars.*
!.dev.vars.example
