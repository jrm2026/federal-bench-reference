---
import '../styles/site.css';
import firm from '../content/config/firm.json';
import curator from '../content/config/curator.json';
const { title, district = 'dnj' } = Astro.props;
const f = { ...firm.base, ...(firm.districts?.[district] ?? {}) };
---
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
</head>
<body>
<div class="advert-banner">Attorney Advertising · An independent reference — not affiliated with or endorsed by any court or judge</div>
<header class="siteheader">
  <div class="inner">
    <a href="/" class="sitemark">Federal Bench Reference</a>
    <nav class="sitenav">
      <a href={`/districts/${district}/`}>Judges</a>
      <a href="/about/">About</a>
      <a href="/attorney-advertising/">Attorney Advertising</a>
    </nav>
  </div>
</header>
<div class="wrap"><slot /></div>
<footer>
  <div class="inner">
    <div class="advert-block">
      <span class="label">{f.advertising_label}</span> {curator.role_phrase} <b>{curator.curator_name}</b> and sponsored by <b>{f.sponsor_name}</b>, {f.address}, {f.phone}. {f.disclaimer} {f.copyright}
    </div>
    <div class="footlinks">
      <a href="/about/">About &amp; Methodology</a>
      <a href="/attorney-advertising/">Attorney Advertising Notice</a>
    </div>
  </div>
</footer>
</body>
</html>
