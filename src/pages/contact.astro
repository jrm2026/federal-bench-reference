---
import Base from "../layouts/Base.astro";
import { firm, curator, advertisingBlockSettled } from "../config/site.js";
---

<Base title="Contact">
  <div class="breadcrumb" slot="breadcrumb"><a href="/">Home</a> &nbsp;›&nbsp; Contact</div>

  <div class="pagehead">
    <h1>Contact</h1>
    <div class="role">Corrections and questions</div>
  </div>

  <section class="block">
    <div class="prose">
      {advertisingBlockSettled ? (
        <p>
          This reference is maintained by <b>{curator.name}</b> at <b>{firm.name}</b>,{" "}
          {firm.address}, {firm.phone}.
        </p>
      ) : (
        <div class="empty">
          <strong>Contact details are not yet settled</strong>
          They are published when the curator and firm blocks are.
        </div>
      )}
      <p>
        Corrections are welcome and are treated seriously. A fact corrected here is recorded so it
        cannot reappear: the build refuses to publish a fact that has previously been found wrong.
      </p>
    </div>
  </section>
</Base>
