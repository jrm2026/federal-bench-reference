---
import { getCollection } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import OpinionEntry from '../../../../components/OpinionEntry.astro';
import taxonomy from '../../../../content/config/taxonomy.json';
import policy from '../../../../content/config/policy.json';
import sourceHosts from '../../../../content/config/source-hosts.json';

export async function getStaticPaths() {
  const judges = await getCollection('judges');
  const opinions = await getCollection('opinions');
  return judges.filter(j => j.data.canonical).map(j => ({
    params: { district: j.data.district, slug: j.data.slug },
    props: {
      judge: j.data,
      ops: opinions.filter(o => o.data.judge_slug === j.data.slug &&
                                o.data.district === j.data.district).map(o => o.data),
    },
  }));
}
const { judge, ops } = Astro.props;
const isMag = judge.office.startsWith('magistrate');
// A biography source outside the primary host list is marked on the page rather
// than excluded from it. No primary source carries a magistrate judge's
// biography, so excluding them would empty the block. See source-hosts.json.
const primaryHosts = new Set(Object.keys(sourceHosts.primary));
const isSecondary = (u) => { try { return !primaryHosts.has(new URL(u).hostname); } catch { return true; } };
const bioSources = judge.biography?.sources ?? [];
const hasSecondary = bioSources.some(isSecondary);
const disclaimer = policy.magistrate_biography_disclaimer;
// The two tiers are selected on different criteria and read differently, so
// they render in different sections. Splitting on subject_screen alone worked
// only while every record was the career screen.
const year = (o) => o.decision_date?.slice(0, 4)
  ?? o.citation_line.match(/(19|20)\d\d/)?.[0] ?? '';
const newestFirst = (a, b) => year(b).localeCompare(year(a));

const significant = ops.filter(o => o.tier === 'significant');
const selected = significant.filter(o => o.subject_screen === 'qualifying').sort(newestFirst);
const procOnly = ops.filter(o => o.subject_screen === 'excluded');

const intake = taxonomy.subject.intake_filter;
const label = (t) => taxonomy.labels?.[t] ?? t.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());

// Matter-relevant entries, grouped by the subject the reader arrived with. A
// secondary tag counts: a contract ruling that turns on a restrictive covenant
// belongs under both.
const recent = ops.filter(o => o.tier === 'recent');
const byMatter = intake
  .map(t => [t, recent.filter(o => o.subject_primary === t || o.subject_secondary.includes(t)).sort(newestFirst)])
  .filter(([, list]) => list.length);
const counts = Object.fromEntries(intake.map(t => [t,
  ops.filter(o => o.subject_primary === t || o.subject_secondary.includes(t)).length]));

const subjectYears = policy.lookback.subject_district_years;
const cutoff = new Date(Date.now() - subjectYears * 365.25 * 86400000).toISOString().slice(0, 10);
---
<Base title={`Hon. ${judge.name} — Federal Bench Reference`} district={judge.district}>
  <div class="breadcrumb"><a href={`/districts/${judge.district}/`}>District of New Jersey</a> › Judges › {judge.name}</div>

  <div class="judgehead">
    <h1>Hon. {judge.name}</h1>
    <div class="role">{isMag ? 'United States Magistrate Judge' : 'United States District Judge'} · District of New Jersey</div>
    {judge.vicinage && <span class="chip">{judge.vicinage}</span>}
    {judge.render_section === 'fjc_reconciliation' &&
      <span class="chip">FJC record · not on current court directory</span>}
  </div>

  {isMag &&
    <section class="block">
      <h2>Role on the docket</h2>
      <p class="summary">Magistrate judges in this district manage scheduling and discovery, conduct settlement
      conferences, handle criminal initial proceedings, and decide dispositive matters on referral or with the
      consent of the parties. Rulings below are labeled as orders or as reports and recommendations, with the
      district judge's disposition noted where one has been entered.</p>
    </section>}

  <section class="block">
    <h2>Biography</h2>
    {judge.biography
      ? <>
          <p class="summary">{judge.biography.text}</p>
          {judge.biography.source_note &&
            <div class="notice neutral">{judge.biography.source_note}</div>}
          <p class="srcline">
            Sources: {judge.biography.source_labels.map((l, i) =>
              <>{i > 0 && ' · '}<a href={judge.biography.sources[i]} style="color:var(--accent);text-decoration:none">{l}</a>{isSecondary(judge.biography.sources[i]) && '*'}</>)}
            {' · verified '}{judge.biography.last_verified}
          </p>
          {isMag &&
            <div class="notice neutral">{hasSecondary ? `${disclaimer.secondary_marker} ${disclaimer.text}` : disclaimer.text}</div>}
        </>
      : <div class="empty"><strong>Biography pending review</strong>Verified biography will appear here.</div>}
    {judge.service_line_reviewed && <p class="srcline">{judge.service_line_reviewed}</p>}
  </section>

  {judge.other_writings?.length > 0 &&
    <section class="block">
      <h2>Other writings</h2>
      {judge.other_writings.map(w =>
        <p class="summary">{w.url ? <a href={w.url} style="color:var(--accent);text-decoration:none">{w.text}</a> : w.text}</p>)}
    </section>}

  {judge.record_status !== 'represented'
    ? <section class="block">
        <h2>Selected decisions</h2>
        <div class="empty"><strong>{judge.record_status === 'developing' ? 'Developing record' : 'None identified'}</strong>{judge.record_status_note}</div>
      </section>
    : <section class="block">
        <h2>Selected decisions</h2>
        <p class="windownote">{isMag
          ? 'Five most recent verified entries per category. No date cutoff.'
          : 'Career screen. Newest first.'}</p>
        {selected.map(op => <OpinionEntry op={op} />)}
      </section>}

  {procOnly.length > 0 &&
    <section class="block">
      <h2>Procedural rulings</h2>
      <p class="windownote">Discovery, sealing, and case-management rulings. Indexed by procedure only.</p>
      {procOnly.map(op => <OpinionEntry op={op} />)}
    </section>}

  <section class="block">
    <h2>Decisions by matter type</h2>
    <p class="windownote">Commercial matter types. Decisions since {cutoff} ({subjectYears}-year window).</p>

    {byMatter.map(([t, list]) =>
      <>
        <h3 class="mattertype">{label(t)}</h3>
        {list.map(op => <OpinionEntry op={op} />)}
      </>)}

    {byMatter.length === 0 &&
      <div class="empty"><strong>No verified entries yet</strong>Matter-type entries for this judge have not
      cleared review. Absence of an entry is not evidence that no ruling was made.</div>}

    <div class="taggrid" style="margin-top:16px">
      {intake.map(t =>
        <div>{label(t)}<span>{counts[t] ? `${counts[t]} entr${counts[t] === 1 ? 'y' : 'ies'}` : 'No entries'}</span></div>)}
    </div>
    <div class="notice neutral" style="margin-top:12px">Coverage is built subject by subject and is not complete.
    Absence of an entry is not evidence that no ruling was made.</div>
  </section>
</Base>
