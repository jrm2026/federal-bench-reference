---
import Base from '../layouts/Base.astro';
import firm from '../content/config/firm.json';
import curator from '../content/config/curator.json';
---
<Base title="Attorney Advertising Notice — Federal Bench Reference">
  <div class="judgehead"><h1>Attorney advertising notice</h1></div>
  <section class="block">
    <h2>Notice</h2>
    <p class="summary">This website is attorney advertising. {curator.role_phrase} {curator.curator_name} and is
    sponsored by {firm.base.sponsor_name}, {firm.base.address}, {firm.base.phone}.</p>
    <p class="summary">{firm.base.disclaimer}</p>
  </section>
</Base>
